# ============================================================
# Tainails — Variáveis de Ambiente
# Copie para .env e ajuste conforme o ambiente.
# ============================================================

# Database (SQLite local, PostgreSQL/Supabase na Vercel)
DATABASE_URL="file:./dev.db"

# Supabase Storage (necessário em produção; nunca use a service role no cliente)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Session secret — OBRIGATÓRIO EM PRODUÇÃO (o app lançará erro se ausente em prod)
# Gere com: openssl rand -base64 32
SESSION_SECRET=""

# URL base do app (usado por metadataBase, OpenGraph, etc.)
# Em produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Senha para proteger endpoints cron (/api/cron/*)
# Vercel envia header Authorization: Bearer <CRON_SECRET> automaticamente
# Gere com: openssl rand -base64 32
CRON_SECRET=""

# Firebase (para notificações push)
# FIREBASE_SERVER_KEY=""
